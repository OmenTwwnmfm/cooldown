# 工作流脚本在 Linux 上执行，必须是 LF 换行
# 否则会报 bash: $'\r': command not found，而且报错位置很难猜
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.apk   binary
*.aab   binary
